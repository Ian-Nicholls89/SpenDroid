# Build outputs
/build
/app/build
/*.apk
/*.aab

# Gradle
/.gradle
# NB: gradle-wrapper.jar is deliberately tracked - CI has no separate Gradle
# install, so ./gradlew needs it present in the checkout.

# IDE
/.idea
/*.iml
*.iws
*.ipr
.DS_Store

# Local properties (contains SDK paths)
/local.properties

# Keystore
*.keystore
*.jks
# NB: the debug keystore is deliberately tracked. Release builds are signed
# with it, so if CI regenerates it the signing key changes and users get
# "App not installed" (signature mismatch) when updating over an existing install.
!/debug.keystore
!/app/debug.keystore

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Scripts
/push.sh