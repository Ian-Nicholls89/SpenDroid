<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Open on my computer": serving the page over the home Wi-Fi while switched on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A manual update check downloads the release and asks Android to install it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        The bank apps to read notifications from are picked from the launcher's apps. Asking only
        for those avoids the permission to see every installed package.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BudgetApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="SpenDroid"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpenDroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where GoCardless sends the browser once the bank is done, so control comes
                 back here instead of a dead localhost address. singleTask means returning
                 resumes the existing screen rather than stacking a second copy on top. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spendroid" android:host="link-complete" />
            </intent-filter>

            <!-- A bank's own file, shared or opened from another app - email, Drive, Files, a
                 bank's app that exports - to import. CSV goes by many names. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/x-ofx" />
                <data android:mimeType="application/ofx" />
                <data android:mimeType="application/vnd.intu.qfx" />
                <data android:mimeType="application/qif" />
                <data android:mimeType="application/x-qif" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/x-ofx" />
                <data android:mimeType="application/ofx" />
                <data android:mimeType="application/vnd.intu.qfx" />
                <data android:mimeType="application/qif" />
                <data android:mimeType="application/x-qif" />
            </intent-filter>

            <!-- The watch app's "Open on phone": opens the app as it is. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spendroid" android:host="open" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.AvailableToSpendWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/available_to_spend_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CardBillsWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/card_bills_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ThisPeriodWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/this_period_widget_info" />
        </receiver>

        <activity
            android:name=".widget.ThisPeriodConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.SpenDroid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>


        <!-- "That's expected" on a bill that went up. -->
        <receiver android:name=".work.MoneyWatchReceiver" android:exported="false" />

        <receiver
            android:name=".widget.PaydayTimelineWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/payday_timeline_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AheadWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ahead_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ComingUpWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/coming_up_widget_info" />
        </receiver>

        <receiver
            android:name=".data.InstallResultReceiver"
            android:exported="false" />

        <!-- "Open on my computer": the page for the user's own computer, only while they have it on. -->
        <service
            android:name=".web.WebService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the user's own budget to their own computer over their home Wi-Fi, while they have it switched on" />
        </service>
        <receiver
            android:name=".web.WebStopReceiver"
            android:exported="false" />
        <receiver
            android:name=".web.WebImportReceiver"
            android:exported="false" />

        <!-- A category chosen for a payment on the watch. -->
        <service
            android:name=".widget.WatchMessageService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/spendroid"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Card payments from Google Wallet and the bank apps the user picked. -->
        <service
            android:name=".work.SpendListenerService"
            android:exported="true"
            android:label="SpenDroid card spending"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>