<?xml version="1.0" encoding="utf-8"?>
<!-- Every chosen account shows: rows tighten to fit, full at 4×3 and compact or single lines below. The accounts are chosen when it is added, and again from
     long-press → Reconfigure; without a choice it shows the budget's account and the first card. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/period_widget_description"
    android:configure="com.spendroid.widget.ThisPeriodConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_period" />
