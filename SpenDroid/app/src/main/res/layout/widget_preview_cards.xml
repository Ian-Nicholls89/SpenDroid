<?xml version="1.0" encoding="utf-8"?>
<!-- What the card bills widget looks like, shown in the widget picker. Sample figures only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_bg_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Card bills"
        android:textColor="#FFB4C1D6"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Tesco Credit Card"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="▲ Over pace"
            android:textColor="#FFEF5350"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£109.46"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£54.46 of usual £71.89 · £55.00 due in 12 days"
        android:textColor="#FFB4C1D6"
        android:textSize="10sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/preview_card_track"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="61"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_fill" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="39"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_projected" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Nectar Credit Card"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="● Fine"
            android:textColor="#FFB4C1D6"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£855.80"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="£120.00 of your £900.00 · £855.80 due in 25 days"
        android:textColor="#FFB4C1D6"
        android:textSize="10sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/preview_card_track"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="13"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_fill" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="70"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_projected" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="17"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
