<?xml version="1.0" encoding="utf-8"?>
<!-- What the This period widget looks like, shown in the widget picker. Sample figures only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_bg_surface"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This period"
        android:textColor="#FFB4C1D6"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Personal"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£212.40"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Budget · pay cycle · of £600.00"
        android:textColor="#FFB4C1D6"
        android:textSize="9sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/preview_card_track"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="35"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_fill" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● On track · day 12 of 30"
        android:textColor="#FFB4C1D6"
        android:textSize="9sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Credit card"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="£310.00"
            android:textColor="#FFE8EDF5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statement · usual bill £700.00"
        android:textColor="#FFB4C1D6"
        android:textSize="9sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/preview_card_track"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="44"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_card_fill" />
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="56"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● On track · day 14 of 30"
        android:textColor="#FFB4C1D6"
        android:textSize="9sp" />
</LinearLayout>
